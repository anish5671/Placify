# Copy this file to .env and replace the placeholder values before starting Docker Compose.
POSTGRES_USER=preptrack
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=preptrack_db
JWT_SECRET=replace-with-a-base64-encoded-random-key-of-at-least-32-bytes
VITE_API_BASE_URL=https://preptrack-backend-zitk.onrender.com/api
# Comma-separated exact frontend origins. Add your Vercel URL when deploying.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174
APP_FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_AUTH_TOKEN=
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
RESUME_MAX_FILE_SIZE_BYTES=10485760
